Subject: [PATCH] SukiSU: adapt builtin UAPI 6 to NotKernel 4.19 and SUSFS 2.1

Pin: SukiSU-Ultra/SukiSU-Ultra fbc67d004b3b68723e91dd86d50dead1120b4a9a.
Use reproducible version metadata and the existing init.rc boot path rather
than advertising the new preinit runner without its required exec hook.
Remove missing unused headers, keep CONFIG_SECCOMP=n buildable, and guard
SELinux-hide calls whose implementation only exists on kernels >= 5.10.

Keep 4.19's stat/access user-pointer ABI, fault-safe copies, chroot checks,
and live root-grant checks. Read an extra byte so legacy nofault truncation
cannot turn a longer filename into an exact su match.

SUSFS 2.1 does not implement the later priority filter or separate no-su /
zygote_next task markers. Do not expose unsupported commands or invent
no-op APIs: retain its real umounted flag, umount/work handling, and live
allowlist gates. This preserves the existing SUSFS 2.1 behavior; it does not
claim to backport the later SUSFS features. Throne-tracker bounds and root
revocation fixes from the old patch are already in this upstream revision.

diff --git a/kernel/Makefile b/kernel/Makefile
index bed47b8..b1b308c 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -18,70 +18,15 @@ else
 ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include
 endif
 
-MDIR    := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
-
-# ===== preinit runner =====
-KSU_UAPI_INC := $(objtree)/usr/include
-ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
-ksu-y += preinit/preinit.o preinit/blob.o
-
-KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
-	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
-	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
-	-I$(KSU_KERNEL_DIR)/include \
-	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
-	-fno-asynchronous-unwind-tables -fno-unwind-tables \
-	-ffunction-sections -fdata-sections
-
-quiet_cmd_ksu_runner = RUNNER  $@
-      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
-		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
-		rm -f $@.o
-
-$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
-		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
-			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
-			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
-	$(call if_changed,ksu_runner)
-
-targets += preinit/runner.elf
-
-$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
-asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(abspath $(obj)/preinit/runner.elf)\"
-
-else
-$(warning -- KernelSU: $(KSU_UAPI_INC) not found, preinit disabled)
+# This 4.19 integration uses the existing init.rc hooks. It has no preinit
+# exec hook, so installing exported headers must not advertise a runner.
 ccflags-y += -DKSU_NO_PREINIT
-endif
-# ===== end preinit runner =====
-
-REPO_OWNER  := SukiSU-Ultra
-REPO_NAME   := SukiSU-Ultra
-REPO_BRANCH := main
-
-VERSION_BASE    := 40000
-VERSION_OFFSET  := 2815
-
-GIT_BIN  := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin git
-CURL_BIN := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin curl
-
-KSU_SRC := $(if $(filter $(srctree),$(src)),$(src),$(srctree)/$(src))
-KSU_SRC := $(if $(wildcard $(KSU_SRC)/../.git),$(KSU_SRC),$(MDIR))
-
-git_short_sha    = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --short=8 HEAD 2>/dev/null)
-git_branch       = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --abbrev-ref HEAD 2>/dev/null)
-git_commit_count = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-list --count $(REPO_BRANCH) 2>/dev/null)
-git_latest_tag   = $(shell cd $(KSU_SRC) && $(GIT_BIN) describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
-
-$(shell cd $(KSU_SRC) 2>/dev/null && [ -f ../.git/shallow ] && $(GIT_BIN) fetch --unshallow 2>/dev/null)
 
-GITHUB_API_BASE  := https://api.github.com/repos/$(REPO_OWNER)/$(REPO_NAME)
-KSU_GITHUB_VER   := $(shell $(CURL_BIN) -s "$(GITHUB_API_BASE)/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/')
-GITHUB_COMMITS   := $(shell $(CURL_BIN) -sI "$(GITHUB_API_BASE)/commits?sha=$(REPO_BRANCH)&per_page=1" 2>/dev/null | grep -i "link:" | sed -n 's/.*page=\([0-9]*\)>; rel="last".*/\1/p')
-LOCAL_COUNT     := $(if $(GITHUB_COMMITS),$(GITHUB_COMMITS),$(git_commit_count))
-KSU_VERSION     := $(if $(LOCAL_COUNT),$(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) - $(VERSION_OFFSET)),13000)
-VERSION_TAG     := $(or $(KSU_GITHUB_VER),$(git_latest_tag),4.2.1)
-KSU_VERSION_FULL := $(if $(call git_short_sha),v$(VERSION_TAG)-$(call git_short_sha)@$(call git_branch),v$(VERSION_TAG)-$(REPO_NAME)-unknown@unknown)
+# Pinned metadata, without network requests from make. Upstream's formula is
+# 40000 + main commit count (3910 on 2026-10-27) - 2815 = 41095.
+REPO_NAME := SukiSU-Ultra
+KSU_VERSION := 41095
+KSU_VERSION_FULL := v4.2.1-fbc67d00-notkernel
 $(info -- $(REPO_NAME) version: $(KSU_VERSION) [$(KSU_VERSION_FULL)])
 
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
diff --git a/kernel/feature/adb_root.c b/kernel/feature/adb_root.c
index d2f867c..c383233 100644
--- a/kernel/feature/adb_root.c
+++ b/kernel/feature/adb_root.c
@@ -10,8 +10,11 @@ static inline long is_exec_adbd(const char *filename)
     if (strstr(filename, "adbd"))
         pr_info("is_exec_adbd() => filename: %s\n", filename);
 
-    return (susfs_starts_with(filename, "/apex/") &&
-                susfs_ends_with(filename, "/adbd"));
+    size_t len = strlen(filename);
+
+    return len >= sizeof("/apex/") - 1 + sizeof("/adbd") - 1 &&
+           !strncmp(filename, "/apex/", sizeof("/apex/") - 1) &&
+           !strcmp(filename + len - (sizeof("/adbd") - 1), "/adbd");
 }
 #else
 static const char kAdbd[] = "/adbd";
diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index f458e56..eb43873 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -74,7 +74,8 @@ int ksu_handle_execveat_init(struct filename *filename, struct user_arg_ptr *arg
 
     if (likely(!strstr(filename->name, "/app_process") && !strstr(filename->name, "/adbd") && !strstr(filename->name, "/stub_zygote"))) {
         pr_info("susfs: mark no sucompat checks for pid: '%d', exec: '%s'\n", current->pid, filename->name);
-        susfs_set_current_proc_no_su();
+        /* SUSFS 2.1 has no no-su task marker. Live allowlist checks below
+         * and at the kernel call sites still decide every su request. */
         // - marking proc umounted here is useless because only zygote spawned processes will umount
         //   the sus mounts, tho other susfs features still rely on proc_umounted check, but
         //   it is fine to not spoof for init spawned processes.
@@ -179,44 +180,47 @@ int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
                         flags);
 }
 
-int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode,
-             int *__unused_flags)
+/* 4.19's access/stat hooks run before getname(): these arguments are user
+ * paths, not struct filename. Copy safely before inspecting or replacing one.
+ */
+static int ksu_handle_path_user(const char __user **filename, const char *syscall_name)
 {
-    if (unlikely(IS_ERR(*filename) || (*filename)->name == NULL))
-        return 0;
+    /* The old nofault helper terminates a full buffer: preserve the byte
+     * after su's NUL position so longer names cannot become an exact match.
+     */
+    char path[sizeof(su_path) + 1] = { 0 };
+    char __user *replacement;
 
-    if (likely(memcmp((*filename)->name, su_path, sizeof(su_path))))
+    if (!filename || !*filename || IS_ERR(*filename))
         return 0;
-
-    if (current_chrooted())
-    {
-        pr_err("ksu_handle_faccessat: su found but NOT allowed! Because current process is running in chrooted environment\n");
+    if (!READ_ONCE(ksu_su_compat_enabled) ||
+        !__ksu_is_allow_uid_for_current(current_uid().val))
         return 0;
-    }
-
-    pr_info("ksu_handle_faccessat: su->sh!\n");
-    memcpy((void *)((*filename)->name), sh_path, sizeof(sh_path));
-    return 0;
-}
-
-int ksu_handle_stat(int *dfd, struct filename **filename, int *flags) {
-    if (unlikely(IS_ERR(*filename) || (*filename)->name == NULL))
+    if (ksu_strncpy_from_user_nofault(path, *filename, sizeof(path)) <= 0)
         return 0;
-
-    if (likely(memcmp((*filename)->name, su_path, sizeof(su_path))))
+    if (memcmp(path, su_path, sizeof(su_path)) || current_chrooted())
         return 0;
 
-    if (current_chrooted())
-    {
-        pr_err("ksu_handle_stat: su found but NOT allowed! Because current process is running in chrooted environment\n");
+    replacement = sh_user_path();
+    if (!replacement)
         return 0;
-    }
 
-    pr_info("ksu_handle_stat: su->sh!\n");
-    memcpy((void *)((*filename)->name), sh_path, sizeof(sh_path));
+    pr_info("%s: su->sh!\n", syscall_name);
+    *filename = replacement;
     return 0;
 }
 
+int ksu_handle_faccessat(int *dfd, const char __user **filename, int *mode,
+             int *__unused_flags)
+{
+    return ksu_handle_path_user(filename, "faccessat");
+}
+
+int ksu_handle_stat(int *dfd, const char __user **filename, int *flags)
+{
+    return ksu_handle_path_user(filename, "stat");
+}
+
 #else
 __attribute__((hot)) static __always_inline bool __is_su_allowed(const void **ptr_to_check)
 {
