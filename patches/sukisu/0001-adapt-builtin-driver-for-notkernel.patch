Subject: [PATCH] SukiSU: adapt the pinned builtin driver to NotKernel 4.19

Pin: SukiSU-Ultra/SukiSU-Ultra 624727d1077f5afea894f066bcb8ca70079cf802.
Keep version generation offline, remove the unused compile.h dependency,
handle CONFIG_SECCOMP=n, and use local string checks for the SUSFS 2.1 API.

Backport the throne-tracker bounds/allocation fixes from upstream commits
c6d2bb9a9f6e56b75b791c002482f15ac984b53e (Kamenta) and
8c74411cb713be2e106b2f15f3c4bf5f02274efd (Wang Han).
Recheck root grants in sucompat, following the revocation fix in
03079cccc9910624344d69d544bc2dcc7235f5fe (ShirkNeko); retain this revision's
boolean hooks instead of importing the later SUSFS API migration.

diff --git a/kernel/Makefile b/kernel/Makefile
index 9abf634..ec888f6 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -11,35 +11,10 @@ else
 ccflags-y += -I$(srctree)/$(src) -I$(srctree)/$(src)/include
 endif
 
-MDIR    := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
-
-REPO_OWNER  := SukiSU-Ultra
-REPO_NAME   := SukiSU-Ultra
-REPO_BRANCH := main
-
-VERSION_BASE    := 40000
-VERSION_OFFSET  := 2815
-
-GIT_BIN  := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin git
-CURL_BIN := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin curl
-
-KSU_SRC := $(if $(filter $(srctree),$(src)),$(src),$(srctree)/$(src))
-KSU_SRC := $(if $(wildcard $(KSU_SRC)/../.git),$(KSU_SRC),$(MDIR))
-
-git_short_sha    = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --short=8 HEAD 2>/dev/null)
-git_branch       = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --abbrev-ref HEAD 2>/dev/null)
-git_commit_count = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-list --count $(REPO_BRANCH) 2>/dev/null)
-git_latest_tag   = $(shell cd $(KSU_SRC) && $(GIT_BIN) describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
-
-$(shell cd $(KSU_SRC) 2>/dev/null && [ -f ../.git/shallow ] && $(GIT_BIN) fetch --unshallow 2>/dev/null)
-
-GITHUB_API_BASE  := https://api.github.com/repos/$(REPO_OWNER)/$(REPO_NAME)
-KSU_GITHUB_VER   := $(shell $(CURL_BIN) -s "$(GITHUB_API_BASE)/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/')
-GITHUB_COMMITS   := $(shell $(CURL_BIN) -sI "$(GITHUB_API_BASE)/commits?sha=$(REPO_BRANCH)&per_page=1" 2>/dev/null | grep -i "link:" | sed -n 's/.*page=\([0-9]*\)>; rel="last".*/\1/p')
-LOCAL_COUNT     := $(if $(GITHUB_COMMITS),$(GITHUB_COMMITS),$(git_commit_count))
-KSU_VERSION     := $(if $(LOCAL_COUNT),$(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) - $(VERSION_OFFSET)),13000)
-VERSION_TAG     := $(or $(KSU_GITHUB_VER),$(git_latest_tag),4.1.2)
-KSU_VERSION_FULL := $(if $(call git_short_sha),v$(VERSION_TAG)-$(call git_short_sha)@$(call git_branch),v$(VERSION_TAG)-$(REPO_NAME)-unknown@unknown)
+# Version metadata belongs to the pinned source, not a moving remote branch.
+REPO_NAME := SukiSU-Ultra
+KSU_VERSION := 40545
+KSU_VERSION_FULL := v4.1.2-624727d1-notkernel
 $(info -- $(REPO_NAME) version: $(KSU_VERSION) [$(KSU_VERSION_FULL)])
 
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
diff --git a/kernel/feature/adb_root.c b/kernel/feature/adb_root.c
index 55a5e0a..7db4af9 100644
--- a/kernel/feature/adb_root.c
+++ b/kernel/feature/adb_root.c
@@ -10,8 +10,11 @@ static inline long is_exec_adbd(const char *filename)
     if (strstr(filename, "adbd"))
         pr_info("is_exec_adbd() => filename: %s\n", filename);
 
-    return (susfs_starts_with(filename, "/apex/") &&
-                susfs_ends_with(filename, "/adbd"));
+    size_t len = strlen(filename);
+
+    return len >= sizeof("/apex/") - 1 + sizeof("/adbd") - 1 &&
+           !strncmp(filename, "/apex/", sizeof("/apex/") - 1) &&
+           !strcmp(filename + len - (sizeof("/adbd") - 1), "/adbd");
 }
 #else
 static const char kAdbd[] = "/adbd";
diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index 0cf59f2..ac3211a 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -124,6 +124,10 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
     if (!ksu_handle_execveat_init(filename, (struct user_arg_ptr*)argv_user, (struct user_arg_ptr*)envp_user))
         return 0;
 
+    /* Recheck grants: the task's SUSFS flags can outlive a revoked profile. */
+    if (!__ksu_is_allow_uid_for_current(current_uid().val))
+        return 0;
+
     if (likely(memcmp(filename->name, su_path, sizeof(su_path))))
         return 0;
 
diff --git a/kernel/kernel_includes.h b/kernel/kernel_includes.h
index 124f0c0..d2fc69d 100644
--- a/kernel/kernel_includes.h
+++ b/kernel/kernel_includes.h
@@ -5,7 +5,6 @@
 #include <asm/current.h>
 #include <asm/syscall.h>
 #include <crypto/hash.h>
-#include <generated/compile.h>
 #include <generated/utsrelease.h>
 #include <linux/aio.h>
 #include <linux/anon_inodes.h>
diff --git a/kernel/manager/throne_tracker.c b/kernel/manager/throne_tracker.c
index dcdb812..ae2d902 100644
--- a/kernel/manager/throne_tracker.c
+++ b/kernel/manager/throne_tracker.c
@@ -96,7 +96,7 @@ FILLDIR_RETURN_TYPE my_actor(struct dir_context *ctx, const char *name, int name
     }
 
     if (d_type == DT_DIR && my_ctx->depth > 0 && (my_ctx->stop && !*my_ctx->stop)) {
-        struct data_path *data = kzalloc(sizeof(struct data_path), GFP_ATOMIC);
+        struct data_path *data = kzalloc(sizeof(struct data_path), GFP_KERNEL);
 
         if (!data) {
             pr_err("Failed to allocate memory for %s\n", dirpath);
@@ -242,9 +242,13 @@ void track_throne(bool prune_only)
         if (chr != '\n')
             continue;
 
-        count = kernel_read(fp, buf, sizeof(buf), &line_start);
+        count = kernel_read(fp, buf, sizeof(buf) - 1, &line_start);
+        if (count <= 0) {
+            break;
+        }
+        buf[count] = '\0';
 
-        struct uid_data *data = kzalloc(sizeof(struct uid_data), GFP_ATOMIC);
+        struct uid_data *data = kzalloc(sizeof(struct uid_data), GFP_KERNEL);
         if (!data) {
             filp_close(fp, 0);
             goto out;
diff --git a/kernel/policy/app_profile.c b/kernel/policy/app_profile.c
index 5af5c84..f21e425 100644
--- a/kernel/policy/app_profile.c
+++ b/kernel/policy/app_profile.c
@@ -54,6 +54,7 @@ void seccomp_filter_release(struct task_struct *tsk);
 
 static void disable_seccomp(void)
 {
+#ifdef CONFIG_SECCOMP
     if (!!!current->seccomp.mode) {
         return;
     }
@@ -102,6 +103,7 @@ static void disable_seccomp(void)
     seccomp_filter_release(fake);
     kfree(fake);
 #endif
+#endif /* CONFIG_SECCOMP */
 }
 
 int escape_with_root_profile(void)
