diff --git a/kernel/hook/lsm_hook.c b/kernel/hook/lsm_hook.c
index 4990551..1627db6 100644
--- a/kernel/hook/lsm_hook.c
+++ b/kernel/hook/lsm_hook.c
@@ -22,6 +22,11 @@ extern u32 susfs_zygote_next_sid;
 extern void disable_seccomp(void);
 extern struct work_struct susfs_extra_works;
 
+/* SUSFS 2.1 uses its single umounted flag for spoofing; it has no separate
+ * no-su or zygote_next marker. Keep real umount/work and manager handling;
+ * every sucompat hook still checks the live allowlist before granting root.
+ */
+
 static inline void ksu_handle_extra_susfs_work(void)
 {
     if (work_pending(&susfs_extra_works))
@@ -33,7 +38,6 @@ static inline void ksu_handle_extra_susfs_work(void)
 static int handle_zygote_setresuid(uid_t ruid) {
     // Check if spawned process is isolated service first, and force to do umount if so
     if (is_isolated_process(ruid)) {
-        susfs_set_current_proc_no_su();
         susfs_set_current_proc_umounted();
         goto do_umount;
     }
@@ -52,7 +56,6 @@ static int handle_zygote_setresuid(uid_t ruid) {
     // - Check if spawned process is normal user app and needs to be umounted
     // - Now app_profile for webview_zygote is available in KernelSU manager
     if (likely(is_appuid(ruid) && ksu_uid_should_umount(ruid))) {
-        susfs_set_current_proc_no_su();
         susfs_set_current_proc_umounted();
         goto do_umount;
     }
@@ -64,7 +67,6 @@ static int handle_zygote_setresuid(uid_t ruid) {
     }
 
     // Process not umounted but also root not allowed
-    susfs_set_current_proc_no_su();
     return 0;
 
 do_umount:
@@ -82,9 +84,7 @@ do_umount:
 static int handle_zygote_next_setresuid(uid_t ruid) {
     // Check if spawned process is isolated service first, and force to do umount if so
     if (is_isolated_process(ruid)) {
-        susfs_set_current_proc_no_su();
         susfs_set_current_proc_umounted();
-        susfs_set_current_proc_umounted_for_zygote_next();
         goto do_susfs_work;
     }
 
@@ -102,9 +102,7 @@ static int handle_zygote_next_setresuid(uid_t ruid) {
     // - Check if spawned process is normal user app and needs to be umounted
     // - Now app_profile for webview_zygote is available in KernelSU manager
     if (likely(is_appuid(ruid) && ksu_uid_should_umount(ruid))) {
-        susfs_set_current_proc_no_su();
         susfs_set_current_proc_umounted();
-        susfs_set_current_proc_umounted_for_zygote_next();
         goto do_susfs_work;
     }
 
@@ -115,7 +113,6 @@ static int handle_zygote_next_setresuid(uid_t ruid) {
     }
 
     // Process not umounted but also root not allowed
-    susfs_set_current_proc_no_su();
     return 0;
 
 do_susfs_work:
